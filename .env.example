# Aethelgard — Environment Variables
# =====================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.
#
# Usage: docker compose --env-file .env up -d

# ── OpenClaw ──────────────────────────────────────────────────────────────────
# Generate with: openclaw token create --name aethelgard-governed
OPENCLAW_TOKEN=

# Model for OpenClaw to use (Aethelgard governs regardless of choice)
OPENCLAW_MODEL=gemma4:e4b

# ── Aethelgard ────────────────────────────────────────────────────────────────
# Governance mode: false=enforce, true=observe only (safe for testing)
AETHELGARD_SHADOW_MODE=false

# Log verbosity: DEBUG | INFO | WARNING
AETHELGARD_LOG_LEVEL=INFO

# Stage 2 classifier model
AETHELGARD_CLASSIFIER_MODEL=qwen2.5:1.5b

# Stage 3 semantic filter (opt-in)
AETHELGARD_SEMANTIC_FILTER=false
AETHELGARD_SEMANTIC_MODEL=llama-guard3

# ── Optional: DeepSeek backend instead of Ollama ──────────────────────────────
DEEPSEEK_API_KEY=

# ── OpenClaw log level ────────────────────────────────────────────────────────
OPENCLAW_LOG_LEVEL=info
