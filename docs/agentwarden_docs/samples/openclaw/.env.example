# OpenClaw + AgentWarden — Environment Variables
# Copy to .env and fill in your values

# ── OpenClaw ──────────────────────────────────────────────────────────────────
# Generate with: openclaw token create --name agentwarden-governed
OPENCLAW_TOKEN=

# ── AgentWarden ────────────────────────────────────────────────────────────────
AGENTWARDEN_SHADOW_MODE=false
AGENTWARDEN_LOG_LEVEL=INFO
AGENTWARDEN_CLASSIFIER_MODEL=agentwarden-router
AGENTWARDEN_SEMANTIC_FILTER=false
AGENTWARDEN_SEMANTIC_MODEL=llama-guard3
